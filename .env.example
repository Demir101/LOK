# Copy to .env to override defaults. Environment variables take precedence over .env.

# SQLite database file (relative paths resolve against the project root).
LOK_DB_PATH=data/lok.db

# Maximum accepted size of an imported scenario JSON file, in bytes (default 2 MiB).
LOK_MAX_IMPORT_BYTES=2097152

# Rows per page in the Evaluation History.
LOK_HISTORY_PAGE_SIZE=25
